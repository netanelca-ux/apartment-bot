# העתק קובץ זה ל-.env ומלא את הפרטים

# טוקן של בוט הטלגרם (מ-@BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ה-Chat ID שלך בטלגרם (שלח /start לבוט, ואחר כך /id ל-@userinfobot)
TELEGRAM_CHAT_ID=your_chat_id_here

# פייסבוק (אופציונלי - עדיף להשתמש בכלי ה-login הידני)
FACEBOOK_EMAIL=your_email@example.com
FACEBOOK_PASSWORD=your_password_here
